[Unit]
Description=SCUT Dr.com wired authentication client
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/scutclient.env
ExecStart=/usr/local/bin/DrcomScutClient -u ${SCUT_USERNAME} -p ${SCUT_PASSWORD} -i eth0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
